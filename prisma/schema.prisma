// Prisma schema for the DSSSB TGT S.St practice app.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ---------- Auth.js (NextAuth) required models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  progress UserProgress[]
  mockAttempts MockAttempt[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ---------- Domain models ----------
// Note: SQL Server has no native enum type, so Prisma enums are not supported
// on this connector. Difficulty ("EASY" | "MEDIUM" | "HARD") and
// ProgressStatus ("ATTEMPTED" | "REVEALED") are plain strings instead,
// validated at the application layer.

model Subject {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String? // small icon/emoji key shown on the subject card
  order     Int      @default(0)
  createdAt DateTime @default(now())

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  slug      String
  subjectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, slug])
  @@map("topics")
}

// options stored as a JSON string (SQL Server has no native Json column type):
// '[{ "id": "a", "text": "..." }, ...]'
model Question {
  id            String     @id @default(cuid())
  topicId       String
  text          String     @db.NVarChar(Max)
  options       String     @db.NVarChar(Max)
  correctOption String
  explanation   String?    @db.NVarChar(Max)
  difficulty    String     @default("MEDIUM")
  isPYQ         Boolean    @default(false)
  pyqYear       Int?
  // Exam date and shift(s) the question appeared in, e.g. "01 Nov 2025 · Shift 2".
  // Several shifts are joined with "; ".
  pyqShift      String?
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  topic    Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@index([topicId])
  @@map("questions")
}

// One row per (user, question). Created when the user answers OR taps
// "show answer" without answering. Deleting rows is how topic progress
// gets reset back to a fresh state.
model UserProgress {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  status         String
  selectedOption String?
  isCorrect      Boolean?
  // Time in milliseconds from when the question first appeared to when it
  // was answered or revealed. Null for rows created before this was tracked.
  timeSpentMs    Int?
  attemptedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("user_progress")
}

// ---------- Mock tests ----------
// Full-length timed tests, independent of the topic-wise question bank.
// Scoring is per test: +marksPerCorrect for a right answer, -negativeMarks for
// a wrong one, 0 for unattempted (DSSSB default: +1 / -0.25).

model MockTest {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?  @db.NVarChar(Max)
  durationMin    Int
  marksPerCorrect Float   @default(1)
  negativeMarks  Float    @default(0.25)
  isPublished    Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  questions MockTestQuestion[]
  attempts  MockAttempt[]

  @@map("mock_tests")
}

// options stored as a JSON string, same shape as Question.options.
// `section` groups questions (e.g. "General Awareness") for section-wise analysis.
model MockTestQuestion {
  id            String  @id @default(cuid())
  testId        String
  order         Int     @default(0)
  section       String?
  text          String  @db.NVarChar(Max)
  options       String  @db.NVarChar(Max)
  correctOption String
  explanation   String? @db.NVarChar(Max)

  test MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("mock_test_questions")
}

// One row per start of a test. `answers` is a JSON string:
// { [questionId]: { sel: string | null, marked: boolean, visited: boolean, timeMs: number } }
// status is "IN_PROGRESS" | "SUBMITTED". The countdown is derived from startedAt on the
// server, so refreshing the page can't reset the clock.
model MockAttempt {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  status       String    @default("IN_PROGRESS")
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  answers      String    @default("{}") @db.NVarChar(Max)
  score        Float?
  correct      Int?
  wrong        Int?
  unattempted  Int?
  timeTakenSec Int?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId, testId])
  @@map("mock_attempts")
}
