# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next_stale_backup_*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local AI tool skill caches (not app code)
/.agents/
/.claude/
/.windsurf/

# local source material / scratch files (not app code)
/Documents/
/Practice.html

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
